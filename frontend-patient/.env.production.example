# Used only when building for native iOS/Android (Vite reads this at BUILD
# time, not runtime — you must rebuild after changing it).
#
# Copy to .env.production before running `npm run build` for a native
# release. Required because a native app has no "same origin" to make
# relative /api/v1 requests against the way the web build does — see
# src/api/client.js.

VITE_API_BASE_URL=https://api.yourdomain.com
