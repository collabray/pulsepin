# Copy this file to .env and fill in real values. Never commit the real
# .env file — it's already in .gitignore.

# --- Environment ---
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changeme-generate-a-real-32+char-secret

# --- Database ---
POSTGRES_DB=pulsepin
POSTGRES_USER=pulsepin
POSTGRES_PASSWORD=changeme-use-a-real-password
DATABASE_URL=postgresql+psycopg://pulsepin:changeme-use-a-real-password@db:5432/pulsepin

# --- Redis ---
REDIS_PASSWORD=changeme-use-a-real-password
REDIS_URL=redis://:changeme-use-a-real-password@redis:6379/0

# --- Field-level encryption / tokenization (required in production) ---
# In ENVIRONMENT=development, these are auto-generated at startup if left
# blank (see app/core/config.py) so local dev works out of the box. That
# auto-generated key is EPHEMERAL — it's regenerated every restart, so
# encrypted dev data won't survive a restart. Set real, persistent values
# here before you need data to survive across restarts, and ALWAYS set
# real values in production (the app refuses to start without them there).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TOKENIZATION_KEY=

# --- SMS / OTP provider ---
# "console" logs OTPs to the backend log instead of sending real SMS — dev only.
SMS_PROVIDER=console
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
SMS_GENERIC_HTTP_URL=
SMS_GENERIC_HTTP_API_KEY=

# --- CAPTCHA (Security Architecture Section 5) ---
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=

# --- VoIP/burner-number detection (Twilio Lookup) ---
ENABLE_LINE_TYPE_LOOKUP=false
TWILIO_LOOKUP_ACCOUNT_SID=
TWILIO_LOOKUP_AUTH_TOKEN=

# --- Feature gates ---
ENABLE_LIVE_DISPATCH=false
SECURITY_SIGNOFF_COMPLETED=false

# --- Domains (used by Traefik in prod profile) ---
API_DOMAIN=api.localhost
PATIENT_DOMAIN=app.localhost
DISPATCHER_DOMAIN=dispatch.localhost
ACME_EMAIL=admin@example.com
